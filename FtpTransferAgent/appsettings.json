{
  "Watch": {
    "Path": "./watch",
    "IncludeSubfolders": false,
    "AllowedExtensions": [ ".txt" ],
    "RequireEndFile": false,
    "TransferEndFiles": true,
    // END = データファイル名 + 末尾文字列（例: data.txt_end）。末尾の大小文字は区別しません。
    // EndFileExtensions との同時指定、末尾が重なる指定（"_end" と ".txt_end"）は不可。
    "EndFileSuffixes": [ ".END", ".TRG", "_end" ]
  },
  "Transfer": {
    "Name": "primary",
    "DisplayName": "",
    "Mode": "ftp",
    "Direction": "put",
    "Host": "localhost",
    "Port": 21,
    "Username": "user",
    "Password": "pass",
    "PrivateKeyPath": "",
    "PrivateKeyPassphrase": "",
    "HostKeyFingerprint": "",
    "RemotePath": "/remote",
    "Concurrency": 1,
    "SftpMaxConcurrentHandshakes": 4,
    "TransferTimeoutSeconds": 0,
    "KeepAliveSeconds": 30,
    "VerifyUploadedFileExists": true,
    "BufferSizeKB": 32,
    "PreserveFolderStructure": false,
    "PerDestinationDeliveryTracking": false,
    "StateDirectory": "",
    "RetryDirectory": null,
    "DeliverySignatureMode": "sizetime",
    "EnableUploadSnapshot": false,
    "AdditionalDestinations": []
  },
  "App": {
    "LockFilePath": ""
  },
  "Retry": {
    "MaxAttempts": 3,
    "DelaySeconds": 5
  },
  "Hash": {
    "Enabled": true,
    "Algorithm": "SHA256"
  },
  "Cleanup": {
    "DeleteAfterVerify": true,
    "DeleteRemoteAfterDownload": false,
    "DeleteRemoteEndFiles": false,
    "DeleteLocalSkippedEndFiles": false
  },
  "Smtp": {
    "Enabled": false,
    "JobName": "",
    "SubjectPrefix": "",
    "SourceServerName": "",
    "SubjectTemplate": "",
    "RelayHost": "localhost",
    "RelayPort": 25,
    "UseTls": false,
    "Username": "",
    "Password": "",
    "From": "noreply@example.com",
    "To": [ "noreply@example.com" ],
    "SuppressPerDestinationFailureDetailEmails": false
  },
  "Logging": {
    "Level": "Information",
    "RollingFilePath": "logs/ftp-transfer-.log",
    "MaxBytes": 10485760,
    "Retention": {
      "Enabled": false,
      "RetentionDays": 30
    }
  }
}
