{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "Watch": {
      "type": "object",
      "properties": {
        "Path": { "type": "string", "minLength": 1 },
        "IncludeSubfolders": { "type": "boolean" },
        "AllowedExtensions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "RequireEndFile": { "type": "boolean" },
        "EndFileExtensions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "TransferEndFiles": { "type": "boolean" }
      },
      "required": [ "Path" ]
    },
    "Transfer": {
      "allOf": [
        { "$ref": "#/definitions/destination" },
        {
          "type": "object",
          "properties": {
            "Direction": { "enum": [ "get", "put", "both" ] },
            "AdditionalDestinations": {
              "type": "array",
              "items": { "$ref": "#/definitions/destination" }
            }
          },
          "required": [ "Direction" ]
        }
      ]
    },
    "App": {
      "type": "object",
      "properties": {
        "LockFilePath": { "type": "string" }
      }
    },
    "Retry": {
      "type": "object",
      "properties": {
        "MaxAttempts": { "type": "integer", "minimum": 0 },
        "DelaySeconds": { "type": "integer", "minimum": 0 }
      }
    },
    "Hash": {
      "type": "object",
      "properties": {
        "Enabled": { "type": "boolean" },
        "Algorithm": { "enum": [ "SHA256", "SHA512" ] },
        "UseServerCommand": { "type": "boolean" }
      },
      "required": [ "Algorithm" ]
    },
    "Cleanup": {
      "type": "object",
      "properties": {
        "DeleteAfterVerify": { "type": "boolean" },
        "DeleteRemoteAfterDownload": { "type": "boolean" },
        "DeleteRemoteEndFiles": { "type": "boolean" },
        "DeleteLocalSkippedEndFiles": { "type": "boolean" }
      }
    },
    "Smtp": {
      "type": "object",
      "properties": {
        "Enabled": { "type": "boolean" },
        "RelayHost": { "type": "string" },
        "RelayPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "UseTls": { "type": "boolean" },
        "Username": { "type": "string" },
        "Password": { "type": "string" },
        "From": { "type": "string", "format": "email" },
        "To": {
          "type": "array",
          "items": { "type": "string", "format": "email" },
          "minItems": 1
        }
      },
      "required": [ "To" ]
    },
    "Logging": {
      "type": "object",
      "properties": {
        "Level": {
          "enum": [ "Trace", "Debug", "Information", "Warning", "Error", "Critical", "None" ]
        },
        "RollingFilePath": { "type": "string", "minLength": 1 },
        "MaxBytes": { "type": "integer", "minimum": 1024 },
        "Retention": {
          "type": "object",
          "properties": {
            "Enabled": { "type": "boolean" },
            "RetentionDays": { "type": "integer", "minimum": 1, "maximum": 3650 }
          }
        }
      },
      "required": [ "RollingFilePath" ]
    }
  },
  "definitions": {
    "destination": {
      "type": "object",
      "properties": {
        "Mode": { "enum": [ "ftp", "sftp" ] },
        "Host": { "type": "string", "minLength": 1 },
        "Port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "Username": { "type": "string", "minLength": 1 },
        "Password": { "type": "string" },
        "PrivateKeyPath": { "type": "string" },
        "PrivateKeyPassphrase": { "type": "string" },
        "HostKeyFingerprint": { "type": "string" },
        "RemotePath": { "type": "string", "minLength": 1 },
        "Concurrency": { "type": "integer", "minimum": 1, "maximum": 16 },
        "PreserveFolderStructure": { "type": "boolean" },
        "TimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
      },
      "required": [ "Mode", "Host", "Username", "RemotePath" ]
    }
  }
}
