{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "Watch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Path": { "type": "string" },
        "IncludeSubfolders": { "type": "boolean" },
        "AllowedExtensions": { "type": "array", "items": { "type": "string" } },
        "RequireEndFile": { "type": "boolean" },
        "EndFileExtensions": { "type": "array", "items": { "type": "string" } },
        "TransferEndFiles": { "type": "boolean" }
      },
      "required": ["Path"]
    },
    "Transfer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Name": { "type": "string" },
        "Mode": { "enum": ["ftp", "sftp"] },
        "Direction": { "enum": ["get", "put"] },
        "Host": { "type": "string" },
        "Port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "Username": { "type": "string" },
        "Password": { "type": "string" },
        "PrivateKeyPath": { "type": "string" },
        "PrivateKeyPassphrase": { "type": "string" },
        "HostKeyFingerprint": { "type": "string" },
        "RemotePath": { "type": "string" },
        "Concurrency": { "type": "integer", "minimum": 1, "maximum": 16 },
        "PreserveFolderStructure": { "type": "boolean" },
        "TimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "KeepAliveSeconds": { "type": "integer", "minimum": 0, "maximum": 3600 },
        "VerifyUploadedFileExists": { "type": "boolean" },
        "BufferSizeKB": { "type": "integer", "minimum": 1, "maximum": 64 },
        "PerDestinationDeliveryTracking": { "type": "boolean" },
        "StateDirectory": { "type": "string" },
        "RetryDirectory": { "type": ["string", "null"] },
        "DeliverySignatureMode": { "enum": ["sizetime", "hash"] },
        "EnableUploadSnapshot": { "type": "boolean" },
        "AdditionalDestinations": {
          "type": "array",
          "items": { "$ref": "#/definitions/Destination" }
        }
      },
      "required": ["Mode", "Direction", "Host", "Username", "RemotePath"]
    },
    "App": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "LockFilePath": { "type": "string" }
      }
    },
    "Retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "MaxAttempts": { "type": "integer", "minimum": 0 },
        "DelaySeconds": { "type": "integer", "minimum": 0 }
      }
    },
    "Hash": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Enabled": { "type": "boolean" },
        "Algorithm": { "enum": ["SHA256", "SHA512"] },
        "UseServerCommand": { "type": "boolean" }
      },
      "required": ["Algorithm"]
    },
    "Cleanup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "DeleteAfterVerify": { "type": "boolean" },
        "DeleteRemoteAfterDownload": { "type": "boolean" },
        "DeleteRemoteEndFiles": { "type": "boolean" },
        "DeleteLocalSkippedEndFiles": { "type": "boolean" }
      }
    },
    "Smtp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Enabled": { "type": "boolean" },
        "RelayHost": { "type": "string" },
        "RelayPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "UseTls": { "type": "boolean" },
        "Username": { "type": "string" },
        "Password": { "type": "string" },
        "From": { "type": "string", "format": "email" },
        "To": { "type": "array", "items": { "type": "string", "format": "email" }, "minItems": 1 },
        "MaxEmailsPerRun": { "type": "integer" },
        "SuppressPerDestinationFailureDetailEmails": { "type": "boolean" }
      }
    },
    "Logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Level": { "enum": ["Trace", "Debug", "Information", "Warning", "Error", "Critical", "None"] },
        "RollingFilePath": { "type": "string" },
        "MaxBytes": { "type": "integer", "minimum": 1024 },
        "Retention": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Enabled": { "type": "boolean" },
            "RetentionDays": { "type": "integer", "minimum": 1, "maximum": 3650 }
          }
        }
      }
    }
  },
  "definitions": {
    "Destination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Name": { "type": "string" },
        "Mode": { "enum": ["ftp", "sftp"] },
        "Host": { "type": "string" },
        "Port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "Username": { "type": "string" },
        "Password": { "type": "string" },
        "PrivateKeyPath": { "type": "string" },
        "PrivateKeyPassphrase": { "type": "string" },
        "HostKeyFingerprint": { "type": "string" },
        "RemotePath": { "type": "string" },
        "Concurrency": { "type": "integer", "minimum": 1, "maximum": 16 },
        "PreserveFolderStructure": { "type": "boolean" },
        "TimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "KeepAliveSeconds": { "type": "integer", "minimum": 0, "maximum": 3600 },
        "VerifyUploadedFileExists": { "type": "boolean" },
        "BufferSizeKB": { "type": "integer", "minimum": 1, "maximum": 64 }
      },
      "required": ["Mode", "Host", "Username", "RemotePath"]
    }
  }
}
